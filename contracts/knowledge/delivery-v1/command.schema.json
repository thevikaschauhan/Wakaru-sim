{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "command_id",
    "operation",
    "scope",
    "arguments",
    "expires_at"
  ],
  "properties": {
    "version": {
      "const": "knowledge_delivery_command_v1"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operation": {
      "enum": [
        "scope_sync",
        "source",
        "withdraw_source",
        "erase_subject"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merchant_id",
        "store_id",
        "subject_kind",
        "subject_id",
        "identity_revision",
        "privacy_generation"
      ],
      "properties": {
        "merchant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "store_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "subject_kind": {
          "enum": [
            "shopper",
            "merchant"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "identity_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "privacy_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "arguments": {
      "type": "object"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
