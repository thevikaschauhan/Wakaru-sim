{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merchant_id",
        "store_id",
        "subject_kind",
        "subject_id",
        "identity_revision",
        "privacy_generation"
      ],
      "properties": {
        "merchant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "store_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "subject_kind": {
          "enum": [
            "shopper",
            "merchant"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "identity_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "privacy_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "scope",
    "arguments"
  ],
  "properties": {
    "version": {
      "const": "knowledge_privacy_request_v1"
    },
    "operation": {
      "enum": [
        "purge_withdrawn",
        "export_retained_page"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "arguments": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "purge_withdrawn"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expected_version"
            ],
            "properties": {
              "expected_version": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "export_retained_page"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "limit",
              "cursor",
              "snapshot"
            ],
            "properties": {
              "family": {
                "enum": [
                  "withdrawals",
                  "delivery_receipts",
                  "events",
                  "cleanup_receipts"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "cursor": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "after",
                      "snapshot",
                      "mac"
                    ],
                    "properties": {
                      "after": {
                        "oneOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        ]
                      },
                      "snapshot": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "mac": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  }
                ]
              },
              "snapshot": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
