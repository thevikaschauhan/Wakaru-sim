{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "command_id",
    "scope",
    "withdrawal_id",
    "withdrawal_sha256",
    "expected_version"
  ],
  "properties": {
    "version": {
      "const": "knowledge_cleanup_request_v1"
    },
    "operation": {
      "const": "purge_withdrawn"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merchant_id",
        "store_id",
        "subject_kind",
        "subject_id",
        "identity_revision",
        "privacy_generation"
      ],
      "properties": {
        "merchant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "store_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "subject_kind": {
          "enum": [
            "shopper",
            "merchant"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "identity_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "privacy_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "withdrawal_id": {
      "type": "string",
      "format": "uuid"
    },
    "withdrawal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
