{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "followup_judgment_result_v1"
    },
    "judgment_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "task_id": {
      "type": "string",
      "enum": [
        "TF01",
        "TF02",
        "TF03",
        "TF04",
        "TF05",
        "TF06",
        "TF07",
        "TF08"
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "merchant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "store_id": {
          "type": "integer",
          "minimum": 1
        },
        "journey_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "message_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "message_revision": {
          "type": "integer",
          "minimum": 0
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "phase": {
          "type": "string",
          "enum": [
            "planning",
            "draft"
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_revision": {
          "type": "integer",
          "minimum": 0
        },
        "conversation_revision": {
          "type": "integer",
          "minimum": 0
        },
        "control_revision": {
          "type": "integer",
          "minimum": 0
        },
        "identity_revision": {
          "type": "integer",
          "minimum": 0
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rubric_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "threshold_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "resolved_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "merchant_id",
        "store_id",
        "journey_id",
        "phase",
        "snapshot_sha256",
        "evidence_revision",
        "conversation_revision",
        "control_revision",
        "identity_revision",
        "policy_sha256",
        "rubric_sha256",
        "threshold_version",
        "provider",
        "adapter_version",
        "resolved_model"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "draft"
              }
            }
          },
          "then": {
            "required": [
              "message_id",
              "message_revision",
              "content_sha256",
              "ordinal"
            ]
          }
        }
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semantic_input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "service_status": {
      "type": "string",
      "enum": [
        "evaluated",
        "unavailable",
        "unresolved",
        "stale",
        "not_applicable"
      ]
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "choice"
            },
            "choice": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "probabilities": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 32,
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "choice",
            "probabilities",
            "confidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "score"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "legend": {
              "const": [
                "0",
                "1",
                "2",
                "3"
              ]
            },
            "probabilities": {
              "type": "object",
              "properties": {
                "0": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "2": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "3": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "0",
                "1",
                "2",
                "3"
              ],
              "additionalProperties": false
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "value",
            "legend",
            "probabilities",
            "confidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "noul"
            },
            "yes_probability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "yes_probability"
          ],
          "additionalProperties": false
        }
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "requires_review",
        "not_applicable"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 32
    },
    "provider_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "response_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "usage": {
      "type": "object",
      "properties": {
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_micros": {
          "type": "integer",
          "minimum": 0
        },
        "cache_hit": {
          "type": "boolean"
        }
      },
      "required": [
        "latency_ms",
        "input_tokens",
        "output_tokens",
        "cost_micros",
        "cache_hit"
      ],
      "additionalProperties": false
    },
    "error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "schema_version",
    "judgment_id",
    "instance_id",
    "task_id",
    "binding",
    "request_sha256",
    "semantic_input_sha256",
    "input_evidence_refs",
    "service_status",
    "disposition",
    "reason_codes",
    "usage"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "service_status": {
            "const": "evaluated"
          }
        }
      },
      "then": {
        "required": [
          "answer",
          "provider_request_id",
          "response_version"
        ]
      },
      "else": {
        "not": {
          "required": [
            "answer"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "service_status": {
            "type": "string",
            "enum": [
              "unavailable",
              "unresolved",
              "stale"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "requires_review"
          }
        },
        "required": [
          "error_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "service_status": {
            "const": "not_applicable"
          }
        }
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "not_applicable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "TF01"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "type": {
                "const": "choice"
              },
              "choice": {
                "type": "string",
                "enum": [
                  "useful_change",
                  "no_useful_change",
                  "insufficient"
                ]
              },
              "probabilities": {
                "type": "object",
                "properties": {
                  "useful_change": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "no_useful_change": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "insufficient": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "useful_change",
                  "no_useful_change",
                  "insufficient"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "TF02"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "type": {
                "const": "choice"
              },
              "choice": {
                "type": "string",
                "enum": [
                  "explicit_report",
                  "behavior_only",
                  "unsupported",
                  "conflicting"
                ]
              },
              "probabilities": {
                "type": "object",
                "properties": {
                  "explicit_report": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "behavior_only": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "unsupported": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "conflicting": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "explicit_report",
                  "behavior_only",
                  "unsupported",
                  "conflicting"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "TF03"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "type": {
                "const": "score"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "TF04"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "type": {
                "const": "choice"
              },
              "choice": {
                "type": "string",
                "enum": [
                  "adds_useful_information",
                  "answers_prior_question",
                  "repeats",
                  "insufficient"
                ]
              },
              "probabilities": {
                "type": "object",
                "properties": {
                  "adds_useful_information": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "answers_prior_question": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "repeats": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "insufficient": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "adds_useful_information",
                  "answers_prior_question",
                  "repeats",
                  "insufficient"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "TF05"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "type": {
                "const": "choice"
              },
              "choice": {
                "type": "string",
                "enum": [
                  "supported",
                  "contradicted",
                  "missing_evidence",
                  "out_of_scope"
                ]
              },
              "probabilities": {
                "type": "object",
                "properties": {
                  "supported": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "contradicted": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "missing_evidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "out_of_scope": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "supported",
                  "contradicted",
                  "missing_evidence",
                  "out_of_scope"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "TF06"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "type": {
                "const": "noul"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "TF07"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "type": {
                "const": "choice"
              },
              "choice": {
                "type": "string",
                "enum": [
                  "consistent",
                  "conflicts_prior_commitment",
                  "insufficient"
                ]
              },
              "probabilities": {
                "type": "object",
                "properties": {
                  "consistent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "conflicts_prior_commitment": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "insufficient": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "consistent",
                  "conflicts_prior_commitment",
                  "insufficient"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "TF08"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          }
        }
      }
    }
  ]
}
