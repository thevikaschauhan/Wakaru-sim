{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "conversation_context_v1"
    },
    "merchant_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "journey_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "confirmed_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "document_ref": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "subject": {
            "type": "string",
            "maxLength": 65536
          },
          "body": {
            "type": "string",
            "maxLength": 65536
          },
          "purpose_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "revision",
                "sha256"
              ],
              "additionalProperties": false
            },
            "maxItems": 256
          },
          "fact_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "revision",
                "sha256"
              ],
              "additionalProperties": false
            },
            "maxItems": 256
          },
          "promises": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "maxItems": 256
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "maxItems": 256
          },
          "offer_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "revision",
                "sha256"
              ],
              "additionalProperties": false
            },
            "maxItems": 256
          }
        },
        "required": [
          "message_id",
          "ordinal",
          "revision",
          "document_ref",
          "content_sha256",
          "subject",
          "body",
          "purpose_id",
          "accepted_at",
          "outcomes",
          "fact_refs",
          "promises",
          "questions",
          "offer_refs"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "unconfirmed_draft_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "complete": {
      "type": "boolean"
    },
    "missing_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 256
    }
  },
  "required": [
    "schema_version",
    "merchant_id",
    "journey_id",
    "revision",
    "confirmed_messages",
    "unconfirmed_draft_refs",
    "complete",
    "missing_paths"
  ],
  "additionalProperties": false
}
