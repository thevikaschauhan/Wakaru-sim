{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "recovery_plan_v2"
    },
    "binding": {
      "type": "object",
      "properties": {
        "merchant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "store_id": {
          "type": "integer",
          "minimum": 1
        },
        "journey_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "message_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "message_revision": {
          "type": "integer",
          "minimum": 0
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "phase": {
          "type": "string",
          "enum": [
            "planning",
            "draft"
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_revision": {
          "type": "integer",
          "minimum": 0
        },
        "conversation_revision": {
          "type": "integer",
          "minimum": 0
        },
        "control_revision": {
          "type": "integer",
          "minimum": 0
        },
        "identity_revision": {
          "type": "integer",
          "minimum": 0
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rubric_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "threshold_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "resolved_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "merchant_id",
        "store_id",
        "journey_id",
        "phase",
        "snapshot_sha256",
        "evidence_revision",
        "conversation_revision",
        "control_revision",
        "identity_revision",
        "policy_sha256",
        "rubric_sha256",
        "threshold_version",
        "provider",
        "adapter_version",
        "resolved_model"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "draft"
              }
            }
          },
          "then": {
            "required": [
              "message_id",
              "message_revision",
              "content_sha256",
              "ordinal"
            ]
          }
        }
      ]
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "judgment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
        "not": {
          "const": "00000000-0000-0000-0000-000000000000"
        }
      },
      "maxItems": 256
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "wait"
            },
            "reevaluate_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "subscriptions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "material_cart_change",
                  "meaningful_activity",
                  "previous_delivery",
                  "permission_change",
                  "approved_fact_change",
                  "merchant_resume"
                ]
              },
              "maxItems": 256
            }
          },
          "required": [
            "action",
            "reevaluate_at",
            "subscriptions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "message"
            },
            "purpose_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "window_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 256
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 256
            }
          },
          "required": [
            "action",
            "purpose_id",
            "window_id",
            "evidence_ids",
            "fact_ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "review"
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 256
            }
          },
          "required": [
            "action",
            "reason_codes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "stop"
            },
            "reason": {
              "type": "string",
              "enum": [
                "converted",
                "suppressed",
                "expired",
                "exhausted",
                "superseded",
                "stopped"
              ]
            }
          },
          "required": [
            "action",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "binding",
    "valid_until",
    "judgment_ids",
    "decision"
  ],
  "additionalProperties": false
}
