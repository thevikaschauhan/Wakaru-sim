{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "followup_judgment_request_v1"
    },
    "binding": {
      "type": "object",
      "properties": {
        "merchant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "store_id": {
          "type": "integer",
          "minimum": 1
        },
        "journey_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "message_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "message_revision": {
          "type": "integer",
          "minimum": 0
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "phase": {
          "type": "string",
          "enum": [
            "planning",
            "draft"
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_revision": {
          "type": "integer",
          "minimum": 0
        },
        "conversation_revision": {
          "type": "integer",
          "minimum": 0
        },
        "control_revision": {
          "type": "integer",
          "minimum": 0
        },
        "identity_revision": {
          "type": "integer",
          "minimum": 0
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rubric_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "threshold_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "resolved_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "merchant_id",
        "store_id",
        "journey_id",
        "phase",
        "snapshot_sha256",
        "evidence_revision",
        "conversation_revision",
        "control_revision",
        "identity_revision",
        "policy_sha256",
        "rubric_sha256",
        "threshold_version",
        "provider",
        "adapter_version",
        "resolved_model"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "draft"
              }
            }
          },
          "then": {
            "required": [
              "message_id",
              "message_revision",
              "content_sha256",
              "ordinal"
            ]
          }
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "semantic_input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "type": "object",
      "properties": {
        "buyer_state_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ],
          "additionalProperties": false
        },
        "delta_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "conversation_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "fact_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "spans": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "source_ref": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "revision",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "text": {
                "type": "string",
                "maxLength": 65536
              },
              "attribution": {
                "type": "string",
                "enum": [
                  "shopper_report",
                  "observed_behavior",
                  "approved_fact",
                  "prior_message",
                  "draft"
                ]
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "received_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "maxItems": 256
              }
            },
            "required": [
              "id",
              "source_ref",
              "text",
              "attribution",
              "occurred_at",
              "received_at",
              "scope"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "eligible_purpose_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 256
        },
        "allowed_window_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 256
        },
        "excluded_purpose_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 256
        },
        "draft_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "history_complete": {
              "type": "boolean"
            },
            "evidence_complete": {
              "type": "boolean"
            },
            "full_text_checked": {
              "type": "boolean"
            },
            "claim_extraction_complete": {
              "type": "boolean"
            },
            "claim_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 256
            },
            "commitment_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 256
            },
            "missing_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 256
            }
          },
          "required": [
            "history_complete",
            "evidence_complete",
            "full_text_checked",
            "claim_extraction_complete",
            "claim_ids",
            "commitment_ids",
            "missing_paths"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "buyer_state_ref",
        "delta_refs",
        "conversation_refs",
        "fact_refs",
        "spans",
        "eligible_purpose_ids",
        "allowed_window_ids",
        "excluded_purpose_ids",
        "coverage"
      ],
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "task_id": {
            "type": "string",
            "enum": [
              "TF01",
              "TF02",
              "TF03",
              "TF04",
              "TF05",
              "TF06",
              "TF07",
              "TF08"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "choice",
              "score",
              "noul"
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 32,
            "maxLength": 8192
          },
          "state_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "maxItems": 256
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "maxItems": 256
          },
          "required": {
            "type": "boolean"
          },
          "applicability": {
            "type": "string",
            "enum": [
              "required",
              "conditional",
              "not_applicable"
            ]
          },
          "applicability_rule_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "instance_id",
          "task_id",
          "type",
          "instructions",
          "state_paths",
          "options",
          "required",
          "applicability",
          "applicability_rule_revision",
          "subject_id"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "task_id": {
                  "const": "TF01"
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "choice"
                },
                "options": {
                  "const": [
                    "useful_change",
                    "no_useful_change",
                    "insufficient"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "task_id": {
                  "const": "TF02"
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "choice"
                },
                "options": {
                  "const": [
                    "explicit_report",
                    "behavior_only",
                    "unsupported",
                    "conflicting"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "task_id": {
                  "const": "TF03"
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "score"
                },
                "options": {
                  "const": [
                    "0",
                    "1",
                    "2",
                    "3"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "task_id": {
                  "const": "TF04"
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "choice"
                },
                "options": {
                  "const": [
                    "adds_useful_information",
                    "answers_prior_question",
                    "repeats",
                    "insufficient"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "task_id": {
                  "const": "TF05"
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "choice"
                },
                "options": {
                  "const": [
                    "supported",
                    "contradicted",
                    "missing_evidence",
                    "out_of_scope"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "task_id": {
                  "const": "TF06"
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "noul"
                },
                "options": {
                  "const": []
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "task_id": {
                  "const": "TF07"
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "choice"
                },
                "options": {
                  "const": [
                    "consistent",
                    "conflicts_prior_commitment",
                    "insufficient"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "task_id": {
                  "const": "TF08"
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "choice"
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 64
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "max_input_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "max_cost_micros": {
      "type": "integer",
      "minimum": 0
    },
    "tools_allowed": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "binding",
    "idempotency_key",
    "semantic_input_sha256",
    "state",
    "questions",
    "deadline_ms",
    "max_input_bytes",
    "max_cost_micros",
    "tools_allowed"
  ],
  "additionalProperties": false
}
