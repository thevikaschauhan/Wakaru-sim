{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vakaru:integration-lineage:c15:receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "service",
    "merchant",
    "store",
    "request_id",
    "task_sha256",
    "census_sha256",
    "matched",
    "erased",
    "remaining",
    "blockers",
    "registered_scope_complete",
    "whole_application_erasure_complete",
    "live_ingestion_enabled",
    "deployment_enabled",
    "email_sends_enabled"
  ],
  "properties": {
    "version": {
      "const": "integration_lineage_c15_v1"
    },
    "service": {
      "enum": [
        "engine",
        "inkwell",
        "wakaru"
      ]
    },
    "merchant": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "store": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "census_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "matched": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "erased": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remaining": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blockers": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "payload_missing_or_changed",
          "unresolved_registered_coverage"
        ]
      }
    },
    "registered_scope_complete": {
      "type": "boolean"
    },
    "whole_application_erasure_complete": {
      "const": false
    },
    "live_ingestion_enabled": {
      "const": false
    },
    "deployment_enabled": {
      "const": false
    },
    "email_sends_enabled": {
      "const": false
    }
  }
}
