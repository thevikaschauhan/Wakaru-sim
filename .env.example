# ===== Flask 应用配置 =====
# SECRET_KEY: 用于 Flask session / itsdangerous token 签名
# REQUIRED — 应用启动会强制校验 (issue #6); 缺失或等于 'mirofish-secret-key' 会拒绝启动
SECRET_KEY=your_secret_key_here
# FLASK_DEBUG: 仅本地开发可设为 True; 生产环境必须为 False (issue #6)
FLASK_DEBUG=False
# FLASK_HOST / FLASK_PORT: 仅 `python run.py` 使用; gunicorn 不读这两个变量
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
# ENVIRONMENT: 设为 production 时启用 HSTS 响应头 (issue #16); 本地 HTTP 开发请留空
ENVIRONMENT=

# ===== API auth + CORS (issue #10) =====
# WAKARU_API_KEY: REQUIRED — shared secret enforced as X-API-Key on every /api/*
#   request (validate() rejects boot if empty). Set the SAME value on the web and
#   worker services and on the vakaru-engine caller. /health stays unauthenticated.
WAKARU_API_KEY=your_wakaru_api_key_here
# ALLOWED_ORIGINS: comma-separated browser origins allowed to call /api/* (CORS).
#   Empty = no browser origin permitted; the engine calls /api/* server→server and
#   needs no CORS. Add a frontend origin here only if a browser app is deployed.
ALLOWED_ORIGINS=

# ===== LLM API 配置 (OpenAI 格式) =====
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
# LLM_API_KEY: REQUIRED — issue #6 (validate() rejects boot if empty)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
# ZEP_API_KEY: REQUIRED — issue #6 (validate() rejects boot if empty)
ZEP_API_KEY=your_zep_api_key_here

# ===== Sentry 错误监控 (可选) =====
# SENTRY_DSN: 留空则禁用 Sentry (no-op)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ===== OASIS 模拟配置 =====
OASIS_DEFAULT_MAX_ROUNDS=10

# ===== Report Agent 配置 =====
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5

# ===== 异步任务队列 (issue #20) =====
# REDIS_URL: /api/cart-recovery/jobs 异步分析 + RQ worker 需要; 同时设置在 web 与
#   worker 两个 Railway 服务上 (优先用私有/内部 URL). 留空则 /jobs 返回 503,
#   但同步 /analyze 不受影响 (issue #20 bridge). Railway Redis 插件会暴露此变量.
REDIS_URL=
# ANALYZE_JOB_TIMEOUT: RQ job 超时秒数 (默认 5400 = 90min). 必须大于工作流内部
#   ~3480s 轮询上限, 否则 worker 中途被 SIGKILL 并泄漏 OASIS 子进程.
ANALYZE_JOB_TIMEOUT=5400

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
